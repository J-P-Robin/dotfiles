# GLOBAL
--ignore='\.DS_Store'

# KARABINER
--ignore='karabiner/assets/'
--ignore='karabiner/automatic_backups/'

# VSCODE
--ignore='vscode/cli/'
--ignore='vscode/extensions/'
--ignore='vscode/argv.json'

# WINDSURF
--ignore='windsurf/cli/'
--ignore='windsurf/extensions/'
--ignore='windsurf/argv.json'

# ZED
--ignore='zed/\.tmp*'
--ignore='zed/conversations/'
--ignore='zed/embeddings/'
--ignore='zed/prompts/'
--ignore='zed/themes/'
